PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Replace with your actual Supabase PostgreSQL connection string:
# postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_SSL=true

JWT_SECRET=nexcampus_secure_jwt_secret_key_at_least_32_characters_long_2026_salt
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key
