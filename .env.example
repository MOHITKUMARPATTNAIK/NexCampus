# ========================================================
# NexCampus Enterprise Campus Management Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Persistent PostgreSQL Connection (Supabase recommended)
# Format: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:password@localhost:5432/nexcampus
DATABASE_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# Authentication & Security
JWT_SECRET=nexcampus_secure_jwt_secret_key_at_least_32_characters_long_2026_salt
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode for development)
# Get credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Payment Mode: 'dummy' (default for simulated instant student direct payments) or 'live' (for real Razorpay checkout)
PAYMENT_MODE=dummy

# Supabase Storage & Services (Optional for direct file bucket management)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
